{
  "data": {
    "symbols": ["BTCUSDT", "ETHUSDT"],
    "interval": "1h",
    "window_size": 96,
    "horizons": [1, 4, 12],
    "train_hours": 4320,
    "val_hours": 720,
    "sentiment_half_life_hours": 12.0
  },
  "augmentation": {
    "enabled": true,
    "num_paths": 6,
    "dt": 1.0,
    "rho": 0.2,
    "max_paths_per_batch": 128
  },
  "optimizer": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [0.9, 0.95],
    "eps": 1e-8
  },
  "training": {
    "batch_size": 32,
    "max_epochs": 80,
    "mixed_precision": true,
    "grad_clip": 1.0,
    "num_workers": 8,
    "scheduler": "cosine_warmup",
    "seed": 1234,
    "patience": 12,
    "warmup_epochs": 8,
    "log_dir": "runs/patchtst"
  }
}
